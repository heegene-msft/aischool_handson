# Microsoft Foundry Project 설정
AZURE_AI_PROJECT_ENDPOINT=https://your-project.services.ai.azure.com/api/projects/your-project-name
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o-mini

# Azure AI Search 설정 (Lab 2: RAG)
AZURE_SEARCH_SERVICE_ENDPOINT=https://your-search.search.windows.net
AZURE_SEARCH_INDEX_NAME=gptkbindex
AZURE_SEARCH_API_KEY=your-azure-search-api-key

# Bing Search Grounding 설정 (Lab 4: 웹 검색)
# 
# 🚀 자동 검색: 비워두면 SDK가 프로젝트에서 Bing connection을 자동으로 찾습니다!
# 
# 수동 설정 옵션:
# - Connection 이름만 입력: SDK가 해당 이름으로 조회
# - 전체 ID 입력: /subscriptions/xxx/.../connections/xxx 형식
#
# Azure AI Foundry > 프로젝트 > Connected resources에서 Connection 이름 확인
BING_CONNECTION_ID=

# (선택) Azure OpenAI 직접 사용시
# AZURE_OPENAI_ENDPOINT=https://your-openai.openai.azure.com/
# AZURE_OPENAI_API_KEY=

# 앱 설정
DEBUG=true
CORS_ORIGINS=*
